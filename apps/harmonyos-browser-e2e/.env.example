# Copy this file to `.env` in this directory, or to the repo root `.env`.
# Model names must match apps/site/docs/en/model-common-config.mdx.

MIDSCENE_MODEL_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
MIDSCENE_MODEL_API_KEY="your-api-key"
MIDSCENE_MODEL_NAME="qwen3.7-plus"
MIDSCENE_MODEL_FAMILY="qwen3"

# Optional. Defaults to the first device from `hdc list targets`.
MIDSCENE_HARMONY_DEVICE_ID=""
